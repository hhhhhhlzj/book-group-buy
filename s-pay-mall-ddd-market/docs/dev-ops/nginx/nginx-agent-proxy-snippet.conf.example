# 智能客服（ai-agent-group-buy-cs，默认 8092）Nginx 反代示例片段
# 使用方式：将内容合并到已有 server { } 中，或单独为客服子域配置；修改后 nginx -t 再 reload。
#
# 反代后，商城 common.js 中 customerServiceBaseUrl 可改为 https://cs.你的域名
# 或 https://主域名（与下列 location 路径一致），勿再写 :8092。

# ---------- 方案 A：独立子域（推荐，无路径冲突） ----------
# server {
#     listen 443 ssl;
#     server_name cs.example.com;
#     location / {
#         proxy_pass http://127.0.0.1:8092;
#         proxy_http_version 1.1;
#         proxy_set_header Host $host;
#         proxy_set_header X-Forwarded-Proto $scheme;
#         proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#     }
# }

# ---------- 方案 B：同域名单路径（仅静态页入口；API 仍直连 8092 或由前端同源访问）----------
location = /group-buy-chat.html {
    proxy_pass http://127.0.0.1:8092/group-buy-chat.html;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
